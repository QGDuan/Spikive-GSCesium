{
  "name": "spikive-gs-inspection",
  "productName": "面向建运一体化转型的实景三维多场景孪生应用底座系统",
  "version": "0.1.0",
  "description": "本地实景三维巡检与航线规划平台",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server.mjs",
    "start": "node server.mjs --production",
    "build:lod": "node scripts/build-streamed-sog.mjs",
    "build": "tsc --noEmit && vite build",
    "test": "node --test scripts/*.test.mjs server/*.test.mjs",
    "deploy:web": "node scripts/prepare-web-deployment.mjs",
    "package:web": "npm run deploy:web && node scripts/package-web-release.mjs"
  },
  "dependencies": {
    "@playcanvas/splat-transform": "3.3.0",
    "playcanvas": "2.21.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  },
  "engines": {
    "node": ">=22.22.1"
  }
}
